{
  "hosting": {
    "public": "./dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/cursos/**", "destination": "/app-shell.html" },
      { "source": "/blog/**", "destination": "/app-shell.html" },
      { "source": "/servicio/**", "destination": "/app-shell.html" },
      { "source": "/productos/**", "destination": "/app-shell.html" }
    ]
  }
}
